{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/azumag/areNews/schemas/slide-spec.schema.json",
  "title": "areNews slide specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "episodeId",
    "title",
    "date",
    "status",
    "estimatedDurationSec",
    "slideCount",
    "theme",
    "generation",
    "contentRules",
    "slides"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "episodeId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string"
    },
    "estimatedDurationSec": {
      "type": "integer",
      "minimum": 0
    },
    "slideCount": {
      "type": "integer",
      "minimum": 1
    },
    "theme": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "aspectRatio",
        "canvas",
        "fonts",
        "colors"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "aspectRatio": {
          "type": "string"
        },
        "canvas": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "fonts": {
          "type": "object"
        },
        "colors": {
          "type": "object"
        },
        "safeAreas": {
          "type": "object"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": true
    },
    "contentRules": {
      "type": "object",
      "additionalProperties": true
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "status"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "estimate",
            "unverified",
            "correction"
          ]
        }
      }
    },
    "speakerFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker",
        "purpose"
      ],
      "properties": {
        "speaker": {
          "type": "string",
          "enum": [
            "china_ai",
            "america_ai",
            "human_cue"
          ]
        },
        "purpose": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "strength"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "strength": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        }
      }
    },
    "dynamicToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "required"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "datetime",
            "url"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "durationSec",
        "title",
        "badges",
        "onScreen",
        "visuals",
        "speakerFlow",
        "sources",
        "notes",
        "updateBeforeRecording"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s[0-9]{3}$"
        },
        "kind": {
          "type": "string"
        },
        "durationSec": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "badges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/badge"
          }
        },
        "onScreen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visuals": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "speakerFlow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/speakerFlow"
          }
        },
        "humanCue": {
          "type": "string"
        },
        "sourceLabel": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updateBeforeRecording": {
          "type": "boolean"
        },
        "dynamicTokens": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/dynamicToken"
          }
        }
      }
    }
  }
}